          "text": [
            "mAP@0.5:0.95 = 0.3062\n",
            "mAP@0.5      = 0.5704\n",
            "AP per class = tensor([0.3420, 0.5095, 0.0671])\n"
          ]
        }
      ],
      "source": [
        "from torchmetrics.detection import MeanAveragePrecision\n",
        "\n",
        "metric = MeanAveragePrecision(iou_type=\"bbox\", class_metrics=True)\n",
        "model.eval()\n",
        "with torch.no_grad():\n",
        "    for imgs_v, anns_v in data_loader_test:\n",
        "        imgs_v = [img.to(device) for img in imgs_v]\n",
        "        preds_v = model(imgs_v)\n",
        "        # torchmetrics ждёт оба на одном устройстве; переводим target на GPU\n",
        "        anns_v = [{k: v.to(device) for k, v in t.items()} for t in anns_v]\n",
        "        metric.update(preds_v, anns_v)\n",
        "\n",
        "res = metric.compute()\n",
        "print(f\"mAP@0.5:0.95 = {res['map']:.4f}\")\n",
        "print(f\"mAP@0.5      = {res['map_50']:.4f}\")\n",
        "print(f\"AP per class = {res['map_per_class']}\")  # классы: without_mask, with_mask, mask_weared_incorrect"
      ]
    },
