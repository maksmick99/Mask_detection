      "source": [
        "metrics = model_yolo.val(data=\"data.yaml\", imgsz=640)\n",
        "print(\"mAP@0.5 =\", metrics.box.map50)\n",
        "print(\"mAP@0.5:0.95 =\", metrics.box.map)"
      ]
    },
