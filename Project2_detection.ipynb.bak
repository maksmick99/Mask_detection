    {
      "cell_type": "code",
      "execution_count": 26,
      "id": "f42abcc8",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 1800x500 with 3 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "from torchvision.ops import box_iou\n",
        "\n",
        "names = {1: 'without_mask', 2: 'with_mask', 3: 'mask_weared_incorrect'}\n",
        "curves = {c: {'scores': [], 'hits': [], 'n_gt': 0} for c in names}\n",
        "\n",
        "model.eval()\n",
        "with torch.no_grad():\n",
        "    for imgs_v, anns_v in data_loader_test:\n",
        "        preds_v = model([img.to(device) for img in imgs_v])\n",
        "        for p, t in zip(preds_v, anns_v):\n",
        "            p = {k: v.cpu() for k, v in p.items()}\n",
        "            iou = box_iou(p['boxes'], t['boxes']) if len(p['boxes']) and len(t['boxes']) else None\n",
        "            for c in names:\n",
        "                gt_mask = t['labels'] == c\n",
        "                curves[c]['n_gt'] += int(gt_mask.sum())\n",
        "                pm = p['labels'] == c\n",
        "                for s, bi in zip(p['scores'][pm], p['boxes'][pm]):\n",
        "                    hit = False\n",
        "                    if iou is not None and gt_mask.any():\n",
        "                        j = (p['boxes'] == bi).all(dim=1).nonzero()[0, 0]\n",
        "                        hit = bool((iou[j][gt_mask] >= 0.5).any())\n",
        "                    curves[c]['scores'].append(float(s))\n",
        "                    curves[c]['hits'].append(hit)\n",
        "\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "for ax, (c, d) in zip(axes, curves.items()):\n",
        "    order = np.argsort(d['scores'])[::-1]\n",
        "    hits = np.array(d['hits'])[order]\n",
        "    tp = np.cumsum(hits)\n",
        "    prec = tp / (np.arange(len(hits)) + 1)\n",
        "    rec = tp / max(d['n_gt'], 1)\n",
        "    ax.plot(rec, prec); ax.set_xlabel('Recall'); ax.set_ylabel('Precision')\n",
        "    ax.set_title(f'{names[c]} (IoU≥0.5)'); ax.grid(True)\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "1943386e",
      "metadata": {},
      "source": [
        "## Модель YOLOv8"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 27,
      "id": "97d38bb2",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "done\n"
          ]
        }
      ],
      "source": [
        "import os, shutil\n",
        "import xml.etree.ElementTree as et\n",
        "\n",
        "src_img, src_ann = './images/', './annotations/'\n",
        "classes = ['without_mask', 'with_mask', 'mask_weared_incorrect']  # id: 0,1,2\n",
        "\n",
        "def convert(split, img_names, out_root='./yolo_data'):\n",
        "    for sub in ['images', 'labels']:\n",
        "        os.makedirs(f'{out_root}/{sub}/{split}', exist_ok=True)\n",
        "    for name in img_names:\n",
        "        base = os.path.splitext(name)[0]\n",
        "        shutil.copy(os.path.join(src_img, name), f'{out_root}/images/{split}/{name}')\n",
        "        root = et.parse(os.path.join(src_ann, base + '.xml')).getroot()\n",
        "        w = float(root.find('size/width').text)\n",
        "        h = float(root.find('size/height').text)\n",
        "        lines = []\n",
        "        for obj in root.findall('object'):\n",
        "            cid = classes.index(obj.find('name').text)\n",
        "            bb = obj.find('bndbox')\n",
        "            xmin, ymin = float(bb.find('xmin').text), float(bb.find('ymin').text)\n",
        "            xmax, ymax = float(bb.find('xmax').text), float(bb.find('ymax').text)\n",
        "            xc, yc = (xmin + xmax) / 2 / w, (ymin + ymax) / 2 / h\n",
        "            bw, bh = (xmax - xmin) / w, (ymax - ymin) / h\n",
        "            lines.append(f'{cid} {xc:.6f} {yc:.6f} {bw:.6f} {bh:.6f}')\n",
        "        with open(f'{out_root}/labels/{split}/{base}.txt', 'w') as f:\n",
        "            f.write('\\n'.join(lines))\n",
        "\n",
        "# тот же сплит, что и в Faster R-CNN (seed=1, 80/20) — честное сравнение\n",
        "import torch\n",
        "torch.manual_seed(1)\n",
        "all_imgs = sorted(os.listdir(src_img))\n",
        "indices = torch.randperm(len(all_imgs)).tolist()\n",
        "tsize = int(len(all_imgs) * 0.2)\n",
        "convert('train', [all_imgs[i] for i in indices[:-tsize]])\n",
        "convert('val',   [all_imgs[i] for i in indices[-tsize:]])\n",
        "print('done')"
      ]
    },
