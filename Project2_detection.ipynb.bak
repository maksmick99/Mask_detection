      ],
      "source": [
        "fig, axes = plt.subplots(2, 5, figsize=(20, 8))\n",
        "for ax, img, ann in zip(axes.flat, imgs, annotations):\n",
        "    ax.imshow(img.detach().cpu().permute(1, 2, 0))\n",
        "    for box in ann['boxes'].detach().cpu().numpy():\n",
        "        x, y = box[0], box[1]\n",
        "        ax.add_patch(patches.Rectangle((x, y), box[2]-box[0], box[3]-box[1],\n",
        "                                       linewidth=1, edgecolor='r', facecolor='none'))\n",
        "    ax.axis('off')\n",
        "plt.suptitle('Один батч из data_loader')\n",
        "plt.show()"
      ]
    },
