      "source": [
        "from ultralytics import YOLO\n",
        "\n",
        "model_yolo = YOLO(\"yolov8s.pt\")  # pretrained backbone+neck с COCO: transfer learning\n",
        "\n",
        "model_yolo.train(\n",
        "    data=\"data.yaml\",\n",
        "    epochs=50,\n",
        "    imgsz=640,\n",
        "    batch=8,          # -1 (авто) иногда ошибается; фиксируем под вашу GPU\n",
        "    patience=10,      # early stopping, если val-метрика не растёт\n",
        "    lr0=1e-3,\n",
        "    workers=0,        # Windows + Jupyter: иначе зависания\n",
        "    pretrained=True\n",
        ")\n",
        "\n"
      ]
    },
