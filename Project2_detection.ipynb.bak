      "source": [
        "\n",
        "\n",
        "# dataset_test создаётся с применением трансформации для тестового набора\n",
        "def get_transform(train):\n",
        "    if train:\n",
        "        return A.Compose(\n",
        "            [\n",
        "                A.HorizontalFlip(0.5),\n",
        "                A.RandomBrightnessContrast(p=0.2),\n",
        "                A.ShiftScaleRotate(shift_limit=0.2, scale_limit=0.2, rotate_limit=30, p=0.5),\n",
        "                ToTensorV2(p=1.0),\n",
        "            ],\n",
        "            bbox_params=A.BboxParams(\n",
        "                format=\"pascal_voc\",\n",
        "                label_fields=[\"labels\"],\n",
        "                clip=True,\n",
        "                min_area=1,\n",
        "            ),\n",
        "        )\n",
        "    else:\n",
        "        return A.Compose(\n",
        "            [\n",
        "                ToTensorV2(p=1.0),\n",
        "            ],\n",
        "            bbox_params=A.BboxParams(\n",
        "                format=\"pascal_voc\",\n",
        "                label_fields=[\"labels\"],\n",
        "                clip=True,\n",
        "                min_area=1,\n",
        "            ),\n",
        "        )\n",
        "        \n",
        "dataset_full = FaceMaskDataset(\n",
        "    images_dir, annotations_dir, 224, 224, transforms=get_transform(train=True))\n",
        "\n",
        "dataset_test = FaceMaskDataset(\n",
        "    images_dir, annotations_dir, 224, 224, transforms=get_transform(train=False)\n",
        ")\n",
        "\n",
        "# разделим данные на train и test\n",
        "torch.manual_seed(1)\n",
        "indices = torch.randperm(len(dataset_full)).tolist()\n",
        "\n",
        "test_split = 0.2\n",
        "tsize = int(len(dataset_full)*test_split)\n",
        "dataset = torch.utils.data.Subset(dataset_full, indices[:-tsize])\n",
        "dataset_test = torch.utils.data.Subset(dataset_test, indices[-tsize:])\n",
        "\n",
        "data_loader = torch.utils.data.DataLoader(\n",
        "    dataset, batch_size=10, shuffle=True, num_workers=0,\n",
        "    collate_fn=collate_fn)\n",
        "\n",
        "data_loader_test = torch.utils.data.DataLoader(\n",
        "    dataset_test, batch_size=10, shuffle=False, num_workers=0,\n",
        "    collate_fn=collate_fn)\n",
        "\n"
      ]
    },
